#!/usr/bin/env python3
"""
LOQer Hardware Controller CLI
Unified management of Lenovo LOQ power modes, MUX, fan curves, battery conservation, and GodMode limits.
"""
import sys
import os
import time
import glob
import json
import subprocess

STATUS_FILE = os.environ.get("LOQ_STATUS_FILE") or (
    "/run/user/1000/lenovo-power-status.json"
    if os.path.exists("/run/user/1000/lenovo-power-status.json")
    else "/run/lenovo-power-status.json"
)
LEGION_DIR = os.environ.get("LOQ_SYS_ROOT", "/sys/devices/platform/legion")

def refresh_env_paths():
    global STATUS_FILE, LEGION_DIR
    LEGION_DIR = os.environ.get("LOQ_SYS_ROOT", "/sys/devices/platform/legion")
    STATUS_FILE = os.environ.get("LOQ_STATUS_FILE") or (
        "/run/user/1000/lenovo-power-status.json"
        if os.path.exists("/run/user/1000/lenovo-power-status.json")
        else "/run/lenovo-power-status.json"
    )

def check_loq_hardware():
    refresh_env_paths()
    if os.environ.get("LOQER_FORCE_DEVICE") == "1" or os.environ.get("LOQ_SYS_ROOT"):
        return True
    vendor = ""
    try:
        with open("/sys/class/dmi/id/sys_vendor") as f:
            vendor = f.read().strip().upper()
    except Exception:
        pass
    combined = ""
    for node in ("product_name", "product_family", "product_version"):
        p = f"/sys/class/dmi/id/{node}"
        if os.path.exists(p):
            try:
                with open(p) as f:
                    combined += " " + f.read().strip().upper()
            except Exception:
                pass
    if "LENOVO" in vendor and "LOQ" in combined:
        return True
    if os.path.isdir(LEGION_DIR):
        return True
    return False

if not check_loq_hardware() and len(sys.argv) > 1 and sys.argv[1] not in ("-h", "--help"):
    sys.stderr.write("Error: Unsupported device. LOQer requires a supported Lenovo LOQ laptop.\n")
    sys.exit(1)

# Auto-elevate to root via passwordless sudo if writing hardware registers
if os.geteuid() != 0 and len(sys.argv) > 1 and not os.environ.get("LOQ_SYS_ROOT") and not os.environ.get("LOQER_NO_SUDO"):
    cmd = sys.argv[1].lower()
    is_read_only = cmd in ("-h", "--help", "status", "fancurve", "test-gpu", "gpu-spike", "gputest") or (cmd == "bootlogo" and (len(sys.argv) <= 2 or sys.argv[2] in ("status", "get", "info", "--json", "-j")))
    if not is_read_only:
        try:
            os.execvp("sudo", ["sudo", "-n", "/usr/local/bin/loq-ctl"] + sys.argv[1:])
        except Exception:
            pass

def write_node(path, val):
    val_str = str(val).strip()
    try:
        with open(path, "w") as f:
            f.write(val_str + "\n")
        return True
    except Exception as e:
        if os.environ.get("LOQ_SYS_ROOT") or os.environ.get("LOQER_NO_SUDO"):
            sys.stderr.write(f"Write failed for {path}: {e}\n")
            return False
        try:
            cmd = f'echo "{val_str}" > "{path}"'
            subprocess.run(["sudo", "-n", "/usr/local/bin/loq-hw-write", cmd], check=True, capture_output=True)
            return True
        except Exception as se:
            sys.stderr.write(f"Write failed for {path}: {se}\n")
            return False

def find_legion_hwmon():
    refresh_env_paths()
    matches = glob.glob(os.path.join(LEGION_DIR, "hwmon/hwmon*"))
    if matches:
        return matches[0]
    matches_flat = glob.glob(os.path.join(LEGION_DIR, "hwmon*"))
    if matches_flat and os.path.isdir(matches_flat[0]):
        return matches_flat[0]
    if os.environ.get("LOQ_SYS_ROOT"):
        return None
    for d in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        name_path = os.path.join(d, "name")
        if os.path.isfile(name_path):
            try:
                with open(name_path, "r") as f:
                    if f.read().strip() == "legion_hwmon":
                        return d
            except Exception:
                pass
    return None

def get_legion_profile_path():
    refresh_env_paths()
    prof_in_legion = os.path.join(LEGION_DIR, "platform-profile")
    if os.path.isfile(prof_in_legion):
        return prof_in_legion
    if os.environ.get("LOQ_SYS_ROOT"):
        return None
    for p in glob.glob("/sys/class/platform-profile/platform-profile-*"):
        try:
            with open(os.path.join(p, "name")) as f:
                if "lenovo-legion" in f.read():
                    return os.path.join(p, "profile")
        except Exception:
            pass
    return None

def set_gpu_tgp(ctgp_w, ppab_w):
    refresh_env_paths()
    ok1 = write_node(os.path.join(LEGION_DIR, "gpu_ctgp_powerlimit"), ctgp_w)
    ok2 = write_node(os.path.join(LEGION_DIR, "gpu_ppab_powerlimit"), ppab_w)
    return ok1 and ok2

PROFILES = {
    "quiet": ("low-power", "1", "0", 45, 15),
    "blue": ("low-power", "1", "0", 45, 15),
    "1": ("low-power", "1", "0", 45, 15),
    "low-power": ("low-power", "1", "0", 45, 15),
    "balanced": ("balanced", "2", "0", 60, 20),
    "white": ("balanced", "2", "0", 60, 20),
    "2": ("balanced", "2", "0", 60, 20),
    "performance": ("performance", "3", "0", 105, 25),
    "red": ("performance", "3", "0", 105, 25),
    "3": ("performance", "3", "0", 105, 25),
    "custom": ("custom", "255", "1", 105, 25),
    "pink": ("custom", "255", "1", 105, 25),
    "extreme": ("custom", "255", "1", 105, 25),
    "255": ("custom", "255", "1", 105, 25),
}

def set_profile(p):
    refresh_env_paths()
    p = p.lower().strip()
    if p not in PROFILES:
        sys.stderr.write(f"Error: Invalid profile '{p}'. Valid profiles: quiet, balanced, performance, custom\n")
        return False
    config = PROFILES[p]
    prof_name, powermode, fullspeed, ctgp, ppab = config
    
    canonical = "custom" if prof_name == "custom" else ("performance" if prof_name == "performance" else ("quiet" if prof_name == "low-power" else "balanced"))

    # If explicitly switching profile away from custom, clear fullspeed override
    if prof_name != "custom":
        prev_prof_file = os.path.join(os.environ.get("LOQ_RUN_DIR", "/run"), "loq-prev-profile")
        if os.path.exists(prev_prof_file):
            try:
                os.remove(prev_prof_file)
            except Exception:
                pass
        write_node(os.path.join(LEGION_DIR, "lockfancontroller"), "0")

    # Update thermal_mode if it exists
    thermal_mode_path = os.path.join(LEGION_DIR, "thermal_mode")
    if os.path.exists(thermal_mode_path):
        write_node(thermal_mode_path, canonical)

    legion_p = get_legion_profile_path()
    if legion_p:
        write_node(legion_p, prof_name)
    powermode_path = os.path.join(LEGION_DIR, "powermode")
    if os.path.exists(powermode_path) or not legion_p:
        write_node(powermode_path, powermode)
        
    write_node(os.path.join(LEGION_DIR, "fan_fullspeed"), fullspeed)
    set_gpu_tgp(ctgp, ppab)

    status_files = [STATUS_FILE] if os.environ.get("LOQ_STATUS_FILE") else [
        STATUS_FILE,
        "/run/lenovo-power-status.json",
        "/run/user/1000/lenovo-power-status.json"
    ]
    for sp in status_files:
        if sp and os.path.isfile(sp):
            try:
                with open(sp, "r") as f:
                    sdata = json.load(f)
                sdata["profile"] = canonical
                if canonical == "custom":
                    sdata["fan_fullspeed"] = True
                elif canonical in ("quiet", "balanced", "performance"):
                    sdata["fan_fullspeed"] = False
                with open(sp, "w") as f:
                    json.dump(sdata, f, indent=2)
            except Exception:
                pass

    try:
        subprocess.Popen(["/usr/local/bin/loq-generate-icon", canonical], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass
    return True

def set_mux(m):
    refresh_env_paths()
    m = m.lower().strip()
    modes = {
        "dedicated": "0", "dgpu": "0", "0": "0",
        "igpu": "1", "intel": "1", "1": "1",
        "hybrid": "2", "auto": "2", "2": "2"
    }
    if m not in modes:
        sys.stderr.write(f"Error: Invalid MUX mode '{m}'. Valid modes: hybrid, igpu, dgpu\n")
        return False

    val = modes[m]
    target_node = os.path.join(LEGION_DIR, "igpu_mode") if os.path.exists(os.path.join(LEGION_DIR, "igpu_mode")) else os.path.join(LEGION_DIR, "igpumode")
    ok = write_node(target_node, val)
    alt_node = os.path.join(LEGION_DIR, "igpumode") if target_node.endswith("igpu_mode") else os.path.join(LEGION_DIR, "igpu_mode")
    if os.path.exists(alt_node):
        write_node(alt_node, val)

    status_files = [STATUS_FILE] if os.environ.get("LOQ_STATUS_FILE") else [
        STATUS_FILE,
        "/run/lenovo-power-status.json",
        "/run/user/1000/lenovo-power-status.json"
    ]
    for sp in status_files:
        if sp and os.path.isfile(sp):
            try:
                with open(sp, "r") as f:
                    sdata = json.load(f)
                sdata["igpu_mode"] = int(val)
                with open(sp, "w") as f:
                    json.dump(sdata, f, indent=2)
            except Exception:
                pass
    return ok

def set_ideapad_attribute(attr, val):
    refresh_env_paths()
    val = str(val).strip().lower()
    paths = []
    if os.environ.get("LOQ_IDEAPAD_DIR"):
        paths.append(os.path.join(os.environ["LOQ_IDEAPAD_DIR"], attr))
    paths.append(os.path.join(LEGION_DIR, attr))
    if not os.environ.get("LOQ_SYS_ROOT"):
        paths.extend([
            f"/sys/bus/platform/drivers/ideapad_acpi/VPC2004:00/{attr}",
            f"/sys/devices/pci0000:00/0000:00:1f.0/PNP0C09:00/VPC2004:00/{attr}"
        ])
        paths.extend(glob.glob(f"/sys/bus/platform/drivers/ideapad_acpi/*/{attr}"))

    target_path = next((p for p in paths if os.path.exists(p)), None)
    if not target_path:
        sys.stderr.write(f"Error: sysfs node for '{attr}' not found\n")
        return False

    cur = "0"
    try:
        with open(target_path) as f:
            cur = f.read().strip()
    except Exception:
        pass

    if val in ("status", "get", "read"):
        print(cur)
        return True

    if val in ("toggle", ""):
        new_val = "0" if cur == "1" else "1"
    elif val in ("1", "on", "true", "enable"):
        new_val = "1"
    elif val in ("0", "off", "false", "disable"):
        new_val = "0"
    else:
        sys.stderr.write(f"Error: Invalid value '{val}' for {attr}. Use 1/0, on/off, or toggle.\n")
        return False

    ok = write_node(target_path, new_val)
    if ok:
        status_files = [STATUS_FILE] if os.environ.get("LOQ_STATUS_FILE") else [
            STATUS_FILE,
            "/run/lenovo-power-status.json",
            "/run/user/1000/lenovo-power-status.json"
        ]
        for sp in status_files:
            if sp and os.path.isfile(sp):
                try:
                    with open(sp, "r") as f:
                        sdata = json.load(f)
                    sdata[attr] = (new_val == "1")
                    with open(sp, "w") as f:
                        json.dump(sdata, f, indent=2)
                except Exception:
                    pass
    return ok

def toggle_bool(sysfs_path, state_str=None):
    refresh_env_paths()
    if not os.path.exists(sysfs_path):
        sys.stderr.write(f"Error: Node '{sysfs_path}' not found\n")
        return False
    cur = ""
    try:
        with open(sysfs_path) as f:
            cur = f.read().strip()
    except Exception:
        pass

    if state_str is None or state_str == "" or state_str == "toggle":
        new_val = "0" if cur == "1" else "1"
    elif state_str in ("status", "get", "read"):
        print(cur)
        return True
    elif state_str in ("1", "on", "true", "enable"):
        new_val = "1"
    elif state_str in ("0", "off", "false", "disable"):
        new_val = "0"
    else:
        sys.stderr.write(f"Error: Invalid state '{state_str}'. Use 1/0, on/off, or toggle.\n")
        return False

    ok = write_node(sysfs_path, new_val)
    if ok:
        attr_name = os.path.basename(sysfs_path)
        status_files = [STATUS_FILE] if os.environ.get("LOQ_STATUS_FILE") else [
            STATUS_FILE,
            "/run/lenovo-power-status.json",
            "/run/user/1000/lenovo-power-status.json"
        ]
        for sp in status_files:
            if sp and os.path.isfile(sp):
                try:
                    with open(sp, "r") as f:
                        sdata = json.load(f)
                    sdata[attr_name] = (new_val == "1")
                    with open(sp, "w") as f:
                        json.dump(sdata, f, indent=2)
                except Exception:
                    pass
    return ok

CURVE_PRESETS = {
    "quiet": [{"step": s, "temp": 50 + s*5, "pwm1": max(0, (s-1)*11), "pwm2": max(0, (s-1)*11)} for s in range(1, 11)],
    "balanced": [
        {"step": 1, "temp": 45, "pwm1": 20, "pwm2": 25},
        {"step": 2, "temp": 52, "pwm1": 30, "pwm2": 35},
        {"step": 3, "temp": 58, "pwm1": 42, "pwm2": 45},
        {"step": 4, "temp": 65, "pwm1": 55, "pwm2": 55},
        {"step": 5, "temp": 72, "pwm1": 65, "pwm2": 65},
        {"step": 6, "temp": 78, "pwm1": 75, "pwm2": 75},
        {"step": 7, "temp": 84, "pwm1": 85, "pwm2": 85},
        {"step": 8, "temp": 90, "pwm1": 90, "pwm2": 90},
        {"step": 9, "temp": 94, "pwm1": 95, "pwm2": 95},
        {"step": 10, "temp": 98, "pwm1": 100, "pwm2": 100}
    ],
    "performance": [
        {"step": 1, "temp": 40, "pwm1": 30, "pwm2": 35},
        {"step": 2, "temp": 48, "pwm1": 45, "pwm2": 50},
        {"step": 3, "temp": 55, "pwm1": 60, "pwm2": 65},
        {"step": 4, "temp": 62, "pwm1": 70, "pwm2": 75},
        {"step": 5, "temp": 70, "pwm1": 80, "pwm2": 85},
        {"step": 6, "temp": 75, "pwm1": 90, "pwm2": 90},
        {"step": 7, "temp": 80, "pwm1": 95, "pwm2": 95},
        {"step": 8, "temp": 85, "pwm1": 100, "pwm2": 100},
        {"step": 9, "temp": 90, "pwm1": 100, "pwm2": 100},
        {"step": 10, "temp": 95, "pwm1": 100, "pwm2": 100}
    ],
    "max": [{"step": s, "temp": 20 + (s - 1) * 5, "pwm1": 100, "pwm2": 100} for s in range(1, 11)]
}

def set_fan_fullspeed(val=None):
    refresh_env_paths()
    cur = "0"
    try:
        with open(os.path.join(LEGION_DIR, "fan_fullspeed")) as f:
            cur = f.read().strip()
    except Exception:
        pass

    if val in ("status", "get", "read"):
        print(cur)
        return True

    enable = (cur != "1") if (val is None or val in ("toggle", "")) else (str(val).lower() in ("1", "on", "true", "enable"))

    prev_prof_file = os.path.join(os.environ.get("LOQ_RUN_DIR", "/run"), "loq-prev-profile")
    if enable:
        cur_prof = "balanced"
        legion_p = get_legion_profile_path()
        if legion_p and os.path.exists(legion_p):
            try:
                cur_prof = open(legion_p).read().strip()
            except Exception:
                pass
        
        if cur_prof != "custom" and not os.path.exists(prev_prof_file):
            try:
                with open(prev_prof_file, "w") as f:
                    f.write(cur_prof)
            except Exception:
                pass
            set_profile("custom")

        write_node(os.path.join(LEGION_DIR, "fan_fullspeed"), "1")
        apply_fan_points(CURVE_PRESETS["max"])
        write_node(os.path.join(LEGION_DIR, "lockfancontroller"), "1")
        print("Emergency fan fullspeed enabled (100% boost).")
    else:
        write_node(os.path.join(LEGION_DIR, "fan_fullspeed"), "0")
        write_node(os.path.join(LEGION_DIR, "lockfancontroller"), "0")
        
        prev_prof = None
        if os.path.exists(prev_prof_file):
            try:
                with open(prev_prof_file) as f:
                    prev_prof = f.read().strip()
                os.remove(prev_prof_file)
            except Exception:
                pass
        
        if prev_prof and prev_prof in PROFILES:
            set_profile(prev_prof)
            print(f"Emergency fan fullspeed disabled; restored profile: {prev_prof}")
        else:
            print("Emergency fan fullspeed disabled; unlocked fan controller.")
    return True

def validate_fan_curve(points):
    """
    Validates a 10-point fan curve.
    Requirements:
    - Exactly 10 points (steps 1 through 10)
    - Monotonically increasing or non-decreasing temperature
    - PWM bounds (pwm1 and pwm2 in 0..100)
    """
    if not isinstance(points, list):
        return False, f"Fan curve must be a list of points (got {type(points).__name__})"
    if len(points) != 10:
        return False, f"Fan curve must contain exactly 10 points (got {len(points)})"

    prev_temp = -1
    for i, pt in enumerate(points):
        if not isinstance(pt, dict):
            return False, f"Point {i+1} is not a dictionary"
        for key in ("step", "temp", "pwm1", "pwm2"):
            if key not in pt:
                return False, f"Point {i+1} missing required field '{key}'"
            if isinstance(pt[key], bool) or not isinstance(pt[key], (int, float)):
                return False, f"Point {i+1} field '{key}' must be numeric"

        step = int(pt["step"])
        if step != i + 1:
            return False, f"Point {i+1} step index mismatch: {step} != {i+1}"

        temp = int(pt["temp"])
        if not (0 <= temp <= 120):
            return False, f"Point {step} temp {temp}°C out of valid range (0-120°C)"

        if temp < prev_temp:
            return False, f"Temperature monotonicity violation at step {step}: {temp}°C < {prev_temp}°C"
        prev_temp = temp

        pwm1 = int(pt["pwm1"])
        pwm2 = int(pt["pwm2"])
        if not (0 <= pwm1 <= 100):
            return False, f"Point {step} PWM1 {pwm1}% out of bounds (0-100%)"
        if not (0 <= pwm2 <= 100):
            return False, f"Point {step} PWM2 {pwm2}% out of bounds (0-100%)"

    return True, ""

def apply_fan_points(points):
    refresh_env_paths()
    hwmon = find_legion_hwmon()
    if not hwmon:
        sys.stderr.write("Error: legion hwmon sysfs node not found\n")
        return False
    write_node(os.path.join(LEGION_DIR, "lockfancontroller"), "1")

    for pt in points:
        step = int(pt.get("step", 1))
        temp = int(pt.get("temp", 50))
        pwm1_raw = int(round(int(pt.get("pwm1", 50)) * 1.27))
        pwm2_raw = int(round(int(pt.get("pwm2", 50)) * 1.27))

        for prefix, raw in (("pwm1", pwm1_raw), ("pwm2", pwm2_raw)):
            t_path = os.path.join(hwmon, f"{prefix}_auto_point{step}_temp")
            p_path = os.path.join(hwmon, f"{prefix}_auto_point{step}_pwm")
            if os.path.exists(t_path): write_node(t_path, temp)
            if os.path.exists(p_path): write_node(p_path, raw)

    fancurve_node = os.path.join(LEGION_DIR, "fancurve")
    if os.path.exists(fancurve_node):
        try:
            write_node(fancurve_node, json.dumps(points))
        except Exception:
            pass

    return True

def handle_fancurve(args):
    refresh_env_paths()
    if not args:
        print("Usage: loq-ctl fancurve [preset <name>|apply <json|file>|get|set <step> <temp> <pwm1> <pwm2>|auto]")
        return False
    sub = args[0].lower()
    if sub == "preset":
        if len(args) < 2:
            sys.stderr.write("Usage: loq-ctl fancurve preset <quiet|balanced|performance|max|auto>\n")
            return False
        preset_name = args[1].lower()
        if preset_name in CURVE_PRESETS:
            ok = apply_fan_points(CURVE_PRESETS[preset_name])
            if ok:
                print(f"Applied fan preset: {preset_name}")
            return ok
        elif preset_name in ("auto", "default", "rom"):
            write_node(os.path.join(LEGION_DIR, "lockfancontroller"), "0")
            print("Reset to EC Auto fan control (unlocked).")
            return True
        else:
            sys.stderr.write(f"Error: Unknown fan curve preset '{preset_name}'. Valid presets: quiet, balanced, performance, max, auto\n")
            return False
    elif sub in ("auto", "reset"):
        write_node(os.path.join(LEGION_DIR, "lockfancontroller"), "0")
        print("Reset to EC Auto fan control (unlocked).")
        return True
    elif sub == "get":
        hwmon = find_legion_hwmon()
        if not hwmon:
            sys.stderr.write("Error: legion hwmon sysfs node not found\n")
            print("[]")
            return False
        points = []
        for step in range(1, 11):
            t_path = os.path.join(hwmon, f"pwm1_auto_point{step}_temp")
            p1_path = os.path.join(hwmon, f"pwm1_auto_point{step}_pwm")
            p2_path = os.path.join(hwmon, f"pwm2_auto_point{step}_pwm")
            temp = int(open(t_path).read().strip()) if os.path.exists(t_path) else 0
            p1_raw = int(open(p1_path).read().strip()) if os.path.exists(p1_path) else 0
            p2_raw = int(open(p2_path).read().strip()) if os.path.exists(p2_path) else 0
            points.append({
                "step": step,
                "temp": temp,
                "pwm1": min(100, int(round(p1_raw / 1.27))),
                "pwm2": min(100, int(round(p2_raw / 1.27)))
            })
        print(json.dumps(points))
        return True
    elif sub in ("apply", "curve", "set-curve"):
        if len(args) < 2:
            sys.stderr.write("Usage: loq-ctl fancurve apply <json_string_or_filepath>\n")
            return False
        raw_input = args[1]
        data = None
        if os.path.isfile(raw_input):
            try:
                with open(raw_input, "r") as f:
                    data = json.load(f)
            except Exception as e:
                sys.stderr.write(f"Error reading fan curve file '{raw_input}': {e}\n")
                return False
        else:
            try:
                data = json.loads(raw_input)
            except Exception as e:
                sys.stderr.write(f"Error: Malformed fan curve JSON syntax: {e}\n")
                return False

        valid, err = validate_fan_curve(data)
        if not valid:
            sys.stderr.write(f"Error: Invalid fan curve: {err}\n")
            return False

        ok = apply_fan_points(data)
        if ok:
            print("Fan curve applied successfully.")
        return ok
    elif sub == "validate":
        if len(args) < 2:
            sys.stderr.write("Usage: loq-ctl fancurve validate <json_string_or_filepath>\n")
            return False
        raw_input = args[1]
        data = None
        if os.path.isfile(raw_input):
            try:
                with open(raw_input, "r") as f:
                    data = json.load(f)
            except Exception as e:
                sys.stderr.write(f"Error reading fan curve file: {e}\n")
                return False
        else:
            try:
                data = json.loads(raw_input)
            except Exception as e:
                sys.stderr.write(f"Error: Malformed fan curve JSON syntax: {e}\n")
                return False
        valid, err = validate_fan_curve(data)
        if not valid:
            sys.stderr.write(f"Error: Invalid fan curve: {err}\n")
            return False
        print("Fan curve is valid.")
        return True
    elif sub == "set":
        if len(args) < 5:
            sys.stderr.write("Usage: loq-ctl fancurve set <step 1-10> <temp 0-120> <pwm1 0-100> <pwm2 0-100>\n")
            return False
        try:
            step = int(args[1])
            temp = int(args[2])
            pwm1 = int(args[3])
            pwm2 = int(args[4])
        except ValueError:
            sys.stderr.write("Error: Fan point parameters must be integers\n")
            return False

        if not (1 <= step <= 10):
            sys.stderr.write(f"Error: Step {step} out of bounds (1-10)\n")
            return False
        if not (0 <= temp <= 120):
            sys.stderr.write(f"Error: Temp {temp}°C out of bounds (0-120°C)\n")
            return False
        if not (0 <= pwm1 <= 100):
            sys.stderr.write(f"Error: PWM1 {pwm1}% out of bounds (0-100%)\n")
            return False
        if not (0 <= pwm2 <= 100):
            sys.stderr.write(f"Error: PWM2 {pwm2}% out of bounds (0-100%)\n")
            return False

        ok = apply_fan_points([{"step": step, "temp": temp, "pwm1": pwm1, "pwm2": pwm2}])
        if ok:
            print(f"Set fan point {step}: {temp}°C, CPU {pwm1}%, GPU {pwm2}%")
        return ok
    else:
        sys.stderr.write(f"Error: Unknown fancurve subcommand '{sub}'\n")
        return False

def set_kbd(val):
    refresh_env_paths()
    val = str(val).strip().lower()
    path = os.path.join(LEGION_DIR, "leds/platform::kbd_backlight_1/brightness")
    if not os.path.exists(path):
        path = "/sys/devices/platform/legion/leds/platform::kbd_backlight_1/brightness"
    if not os.path.exists(path):
        sys.stderr.write("Error: Keyboard backlight node not found\n")
        return False
    levels = {"0": "0", "off": "0", "1": "1", "low": "1", "2": "2", "high": "2"}
    if val in levels:
        return write_node(path, levels[val])
    elif val in ("status", "get", "read"):
        try:
            print(open(path).read().strip())
            return True
        except Exception:
            return False
    elif val in ("", "toggle", "next"):
        try: cur = int(open(path).read().strip())
        except Exception: cur = 0
        return write_node(path, str((cur + 1) % 3))
    else:
        sys.stderr.write(f"Error: Invalid keyboard backlight level '{val}'. Use 0/1/2 or off/low/high.\n")
        return False

def set_refresh(val):
    rate = "60" if str(val).strip().lower() in ("60", "save", "low") else "144"
    subprocess.run(["/home/lavan/.local/bin/set-panel-refresh", rate], check=False)
    return True

def set_powerlimits(args):
    refresh_env_paths()
    if not args:
        sys.stderr.write("Usage: loq-ctl powerlimits <pl1_w> [pl2_w] [ctgp_w] [ppab_w]\n")
        return False
    try:
        pl1 = int(args[0])
    except ValueError:
        sys.stderr.write(f"Error: Invalid PL1 power limit '{args[0]}'. Must be an integer.\n")
        return False

    if not (15 <= pl1 <= 115):
        sys.stderr.write(f"Error: PL1 power limit {pl1}W out of range (15-115W)\n")
        return False

    if len(args) > 1:
        try:
            pl2 = int(args[1])
        except ValueError:
            sys.stderr.write(f"Error: Invalid PL2 power limit '{args[1]}'. Must be an integer.\n")
            return False
    else:
        pl2 = min(135, max(25, pl1 * 2))

    if not (25 <= pl2 <= 135):
        sys.stderr.write(f"Error: PL2 power limit {pl2}W out of range (25-135W)\n")
        return False

    if pl2 < pl1:
        sys.stderr.write(f"Error: PL2 ({pl2}W) cannot be less than PL1 ({pl1}W)\n")
        return False

    ctgp = None
    if len(args) > 2:
        try:
            ctgp = int(args[2])
        except ValueError:
            sys.stderr.write(f"Error: Invalid cTGP power limit '{args[2]}'. Must be an integer.\n")
            return False
        if not (45 <= ctgp <= 105):
            sys.stderr.write(f"Error: GPU cTGP limit {ctgp}W out of range (45-105W)\n")
            return False

    ppab = None
    if len(args) > 3:
        try:
            ppab = int(args[3])
        except ValueError:
            sys.stderr.write(f"Error: Invalid PPAB power limit '{args[3]}'. Must be an integer.\n")
            return False
        if not (5 <= ppab <= 25):
            sys.stderr.write(f"Error: GPU PPAB limit {ppab}W out of range (5-25W)\n")
            return False

    pl1_node = os.path.join(LEGION_DIR, "cpu_longterm_powerlimit")
    pl2_node = os.path.join(LEGION_DIR, "cpu_shortterm_powerlimit")
    if not (os.path.exists(pl1_node) and os.path.exists(pl2_node)):
        sys.stderr.write("Error: CPU power limit sysfs nodes not found\n")
        return False

    ok1 = write_node(pl1_node, pl1)
    ok2 = write_node(pl2_node, pl2)
    if not (ok1 and ok2):
        return False

    if ctgp is not None:
        ctgp_node = os.path.join(LEGION_DIR, "gpu_ctgp_powerlimit")
        if not os.path.exists(ctgp_node):
            sys.stderr.write("Error: GPU cTGP sysfs node not found\n")
            return False
        if not write_node(ctgp_node, ctgp):
            return False

    if ppab is not None:
        ppab_node = os.path.join(LEGION_DIR, "gpu_ppab_powerlimit")
        if not os.path.exists(ppab_node):
            sys.stderr.write("Error: GPU PPAB sysfs node not found\n")
            return False
        if not write_node(ppab_node, ppab):
            return False

    pl_combined_node = os.path.join(LEGION_DIR, "power_limits")
    if os.path.exists(pl_combined_node):
        ctgp_str = str(ctgp) if ctgp is not None else "105"
        ppab_str = str(ppab) if ppab is not None else "25"
        write_node(pl_combined_node, f"{pl1} {pl2} {ctgp_str} {ppab_str}")

    status_files = [STATUS_FILE] if os.environ.get("LOQ_STATUS_FILE") else [
        STATUS_FILE,
        "/run/lenovo-power-status.json",
        "/run/user/1000/lenovo-power-status.json"
    ]
    for sp in status_files:
        if sp and os.path.isfile(sp):
            try:
                with open(sp, "r") as f:
                    sdata = json.load(f)
                sdata["pl1_w"] = pl1
                sdata["pl2_w"] = pl2
                if ctgp is not None:
                    sdata["gpu_ctgp_w"] = ctgp
                if ppab is not None:
                    sdata["gpu_ppab_w"] = ppab
                if "gpu_ctgp_w" in sdata and "gpu_ppab_w" in sdata:
                    sdata["gpu_total_w"] = sdata["gpu_ctgp_w"] + sdata["gpu_ppab_w"]
                with open(sp, "w") as f:
                    json.dump(sdata, f, indent=2)
            except Exception:
                pass

    return True

LBLDESP_PATH = "/sys/firmware/efi/efivars/LBLDESP-871455d0-5576-4fb8-9865-af0824463b9e"
LBLDVC_PATH = "/sys/firmware/efi/efivars/LBLDVC-871455d1-5576-4fb8-9865-af0824463c9f"
ESP_LOGO_DIR = "/boot/efi/EFI/Lenovo/Logo"
PREVIEW_FILE = "/tmp/loqer_active_bootlogo.png"
STATE_FILE = "/run/user/1000/loqer-bootlogo.json"

def get_bootlogo_info():
    if not os.path.exists(LBLDESP_PATH) or not os.path.exists(LBLDVC_PATH):
        return {
            "supported": False,
            "enabled": False,
            "error": "Lenovo DIY Boot Logo EFI variables not found on this system"
        }
    try:
        with open(LBLDESP_PATH, "rb") as f:
            esp_data = f.read()
        with open(LBLDVC_PATH, "rb") as f:
            dvc_data = f.read()
    except Exception as e:
        return {"supported": False, "enabled": False, "error": str(e)}

    if len(esp_data) < 14 or len(dvc_data) < 44:
        return {"supported": False, "enabled": False, "error": "Invalid EFI variable buffer size"}

    esp_payload = esp_data[4:]
    dvc_payload = dvc_data[4:]

    firmware_enabled = (esp_payload[0] == 1)
    max_w = int.from_bytes(esp_payload[1:5], "little")
    max_h = int.from_bytes(esp_payload[5:9], "little")
    support_byte = esp_payload[9]

    formats = []
    if support_byte & 0x01: formats.append("jpg")
    if support_byte & 0x02: formats.append("tga")
    if support_byte & 0x04: formats.append("pcx")
    if support_byte & 0x08: formats.append("gif")
    if support_byte & 0x10: formats.append("bmp")
    if support_byte & 0x20: formats.append("png")

    version = int.from_bytes(dvc_payload[0:4], "little")
    hash_hex = dvc_payload[4:36].hex()

    active_logo = None
    has_esp_file = False
    if os.path.isdir(ESP_LOGO_DIR):
        try:
            for fname in os.listdir(ESP_LOGO_DIR):
                if fname.lower().startswith("mylogo"):
                    has_esp_file = True
                    fpath = os.path.join(ESP_LOGO_DIR, fname)
                    sz = os.path.getsize(fpath)
                    active_logo = {
                        "filename": fname,
                        "path": fpath,
                        "size": sz
                    }
                    break
        except Exception:
            pass

    if active_logo is None and os.path.isfile(STATE_FILE):
        try:
            with open(STATE_FILE, "r") as f:
                st = json.load(f)
                if st.get("active_logo"):
                    active_logo = st.get("active_logo")
                    has_esp_file = True
        except Exception:
            pass

    enabled = firmware_enabled and (has_esp_file or active_logo is not None)

    return {
        "supported": True,
        "enabled": enabled,
        "firmware_enabled": firmware_enabled,
        "width": max_w,
        "height": max_h,
        "formats": formats,
        "version": f"0x{version:05x}",
        "checksum": hash_hex,
        "preview_path": PREVIEW_FILE if os.path.isfile(PREVIEW_FILE) and enabled else "",
        "active_logo": active_logo
    }

def apply_bootlogo(img_path):
    if not os.path.isfile(img_path):
        sys.stderr.write(f"Error: File '{img_path}' does not exist.\n")
        return False

    info = get_bootlogo_info()
    if not info.get("supported"):
        sys.stderr.write("Error: Lenovo boot logo changer not supported on this device.\n")
        return False

    max_w = info["width"]
    max_h = info["height"]
    version = int(info["version"], 16)

    try:
        from PIL import Image
    except ImportError:
        sys.stderr.write("Error: Python Pillow is required for boot logo processing.\n")
        return False

    try:
        img = Image.open(img_path)
    except Exception as e:
        sys.stderr.write(f"Error opening image: {e}\n")
        return False

    if img.width <= 0 or img.height <= 0:
        sys.stderr.write("Error: Invalid image dimensions.\n")
        return False

    canvas = Image.new("RGB", (max_w, max_h), (0, 0, 0))
    img_rgb = img.convert("RGB")
    ratio = min(max_w / img_rgb.width, max_h / img_rgb.height)
    new_w = max(1, int(img_rgb.width * ratio))
    new_h = max(1, int(img_rgb.height * ratio))
    if (new_w, new_h) != (img_rgb.width, img_rgb.height):
        img_rgb = img_rgb.resize((new_w, new_h), Image.Resampling.LANCZOS)
    
    offset_x = (max_w - new_w) // 2
    offset_y = (max_h - new_h) // 2
    canvas.paste(img_rgb, (offset_x, offset_y))

    temp_bmp = f"/tmp/loqer_bootlogo_{max_w}x{max_h}.bmp"
    canvas.save(temp_bmp, "BMP")
    sz = os.path.getsize(temp_bmp)

    try:
        canvas.save(PREVIEW_FILE, "PNG")
        os.chmod(PREVIEW_FILE, 0o644)
    except Exception:
        pass

    if sz > 1572864:
        temp_jpg = f"/tmp/loqer_bootlogo_{max_w}x{max_h}.jpg"
        canvas.save(temp_jpg, "JPEG", quality=95)
        chosen_file = temp_jpg
        ext = "jpg"
        sz = os.path.getsize(temp_jpg)
    else:
        chosen_file = temp_bmp
        ext = "bmp"

    import hashlib
    import zlib
    with open(chosen_file, "rb") as f:
        file_bytes = f.read()

    sha256_hex = hashlib.sha256(file_bytes).hexdigest()
    crc32_int = zlib.crc32(file_bytes[:512]) & 0xffffffff

    import shutil
    try:
        os.makedirs(ESP_LOGO_DIR, exist_ok=True)
        dst_named = os.path.join(ESP_LOGO_DIR, f"mylogo_{max_w}x{max_h}.{ext}")
        dst_compat = os.path.join(ESP_LOGO_DIR, f"mylogo.{ext}")
        shutil.copyfile(chosen_file, dst_named)
        shutil.copyfile(chosen_file, dst_compat)

        # Update LBLDESP
        subprocess.run(["chattr", "-i", LBLDESP_PATH], check=True)
        with open(LBLDESP_PATH, "rb") as f:
            d = bytearray(f.read())
        d[4] = 1
        with open(LBLDESP_PATH, "wb") as f:
            f.write(d)
        subprocess.run(["chattr", "+i", LBLDESP_PATH], check=True)

        # Update LBLDVC
        subprocess.run(["chattr", "-i", LBLDVC_PATH], check=True)
        with open(LBLDVC_PATH, "rb") as f:
            d = bytearray(f.read())
        if version == 0x20003:
            d[8:40] = bytes.fromhex(sha256_hex)
        elif version == 0x20000:
            d[8:12] = crc32_int.to_bytes(4, "little")
        with open(LBLDVC_PATH, "wb") as f:
            f.write(d)
        subprocess.run(["chattr", "+i", LBLDVC_PATH], check=True)

        subprocess.run(["sync"], check=False)

        state_data = {
            "supported": True,
            "enabled": True,
            "width": max_w,
            "height": max_h,
            "version": f"0x{version:05x}",
            "checksum": sha256_hex,
            "active_logo": {
                "filename": f"mylogo_{max_w}x{max_h}.{ext}",
                "size": sz,
                "format": ext.upper()
            }
        }
        for sfile in (STATE_FILE, "/tmp/loqer_bootlogo_state.json"):
            try:
                with open(sfile, "w") as sf:
                    json.dump(state_data, sf, indent=2)
                os.chmod(sfile, 0o644)
            except Exception:
                pass

        print(f"Boot logo applied successfully: {max_w}x{max_h} ({ext.upper()}, {sz} bytes).")
        return True
    except Exception as e:
        sys.stderr.write(f"Failed to apply boot logo: {e}\n")
        return False

def reset_bootlogo():
    info = get_bootlogo_info()
    if not info.get("supported"):
        sys.stderr.write("Error: Lenovo boot logo changer not supported on this device.\n")
        return False

    version = int(info["version"], 16)
    import shutil
    try:
        if os.path.exists(ESP_LOGO_DIR):
            shutil.rmtree(ESP_LOGO_DIR)
        if os.path.exists(PREVIEW_FILE):
            try: os.remove(PREVIEW_FILE)
            except Exception: pass

        # Update LBLDESP
        subprocess.run(["chattr", "-i", LBLDESP_PATH], check=True)
        with open(LBLDESP_PATH, "rb") as f:
            d = bytearray(f.read())
        d[4] = 0
        with open(LBLDESP_PATH, "wb") as f:
            f.write(d)
        subprocess.run(["chattr", "+i", LBLDESP_PATH], check=True)

        # Update LBLDVC
        subprocess.run(["chattr", "-i", LBLDVC_PATH], check=True)
        with open(LBLDVC_PATH, "rb") as f:
            d = bytearray(f.read())
        if version == 0x20000:
            d[8:12] = b"\x00" * 4
        else:
            d[8:44] = b"\x00" * 36
        with open(LBLDVC_PATH, "wb") as f:
            f.write(d)
        subprocess.run(["chattr", "+i", LBLDVC_PATH], check=True)

        subprocess.run(["sync"], check=False)

        state_data = {
            "supported": True,
            "enabled": False,
            "width": info["width"],
            "height": info["height"],
            "version": f"0x{version:05x}",
            "checksum": "00" * 32,
            "active_logo": None
        }
        for sfile in (STATE_FILE, "/tmp/loqer_bootlogo_state.json"):
            try:
                with open(sfile, "w") as sf:
                    json.dump(state_data, sf, indent=2)
                os.chmod(sfile, 0o644)
            except Exception:
                pass

        print("Boot logo reset to OEM stock Lenovo logo successfully.")
        return True
    except Exception as e:
        sys.stderr.write(f"Failed to reset boot logo: {e}\n")
        return False

def handle_bootlogo(args):
    subcmd = args[0].lower() if args else "status"
    if subcmd in ("status", "get", "info"):
        as_json = "--json" in args or "-j" in args
        info = get_bootlogo_info()
        if as_json:
            print(json.dumps(info, indent=2))
        else:
            status_str = "Custom Logo Active" if info.get("enabled") else "OEM Stock Logo Active"
            print(f"Status: {status_str}")
            print(f"Supported: {info.get('supported')}")
            print(f"Max Resolution: {info.get('width')}x{info.get('height')}")
            print(f"Supported Formats: {', '.join(info.get('formats', []))}")
            if info.get("active_logo"):
                logo = info["active_logo"]
                print(f"Active Logo: {logo.get('filename')} ({logo.get('size')} bytes)")
    elif subcmd == "set":
        if len(args) < 2:
            sys.stderr.write("Usage: loq-ctl bootlogo set <image_path>\n")
            sys.exit(1)
        apply_bootlogo(args[1])
    elif subcmd in ("reset", "restore", "clear"):
        reset_bootlogo()
    else:
        sys.stderr.write("Usage: loq-ctl bootlogo [status|set <image_path>|reset]\n")
        sys.exit(1)

def run_gpu_spike(seconds=4):
    try:
        import ctypes
        cl = ctypes.CDLL("libOpenCL.so.1")
        cl.clGetPlatformIDs.argtypes = [ctypes.c_uint, ctypes.POINTER(ctypes.c_void_p), ctypes.POINTER(ctypes.c_uint)]
        cl.clGetDeviceIDs.argtypes = [ctypes.c_void_p, ctypes.c_ulonglong, ctypes.c_uint, ctypes.POINTER(ctypes.c_void_p), ctypes.POINTER(ctypes.c_uint)]
        cl.clCreateContext.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.POINTER(ctypes.c_void_p), ctypes.c_void_p, ctypes.c_void_p, ctypes.POINTER(ctypes.c_int)]
        cl.clCreateContext.restype = ctypes.c_void_p
        cl.clCreateCommandQueue.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_ulonglong, ctypes.POINTER(ctypes.c_int)]
        cl.clCreateCommandQueue.restype = ctypes.c_void_p
        cl.clCreateProgramWithSource.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.POINTER(ctypes.c_char_p), ctypes.POINTER(ctypes.c_size_t), ctypes.POINTER(ctypes.c_int)]
        cl.clCreateProgramWithSource.restype = ctypes.c_void_p
        cl.clBuildProgram.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.POINTER(ctypes.c_void_p), ctypes.c_char_p, ctypes.c_void_p, ctypes.c_void_p]
        cl.clCreateKernel.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.POINTER(ctypes.c_int)]
        cl.clCreateKernel.restype = ctypes.c_void_p
        cl.clCreateBuffer.argtypes = [ctypes.c_void_p, ctypes.c_ulonglong, ctypes.c_size_t, ctypes.c_void_p, ctypes.POINTER(ctypes.c_int)]
        cl.clCreateBuffer.restype = ctypes.c_void_p
        cl.clSetKernelArg.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_size_t, ctypes.c_void_p]
        cl.clEnqueueNDRangeKernel.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_uint, ctypes.POINTER(ctypes.c_size_t), ctypes.POINTER(ctypes.c_size_t), ctypes.POINTER(ctypes.c_size_t), ctypes.c_uint, ctypes.c_void_p, ctypes.c_void_p]
        cl.clFinish.argtypes = [ctypes.c_void_p]

        platform = ctypes.c_void_p()
        cl.clGetPlatformIDs(1, ctypes.byref(platform), None)
        device = ctypes.c_void_p()
        cl.clGetDeviceIDs(platform, 0xFFFFFFFF, 1, ctypes.byref(device), None)

        dev_name = (ctypes.c_char * 256)()
        cl.clGetDeviceInfo(device, 0x102B, 256, dev_name, None)
        print(f"[LOQer] Target GPU: {dev_name.value.decode()}")

        err = ctypes.c_int(0)
        ctx = cl.clCreateContext(None, 1, ctypes.byref(device), None, None, ctypes.byref(err))
        queue = cl.clCreateCommandQueue(ctx, device, 0, ctypes.byref(err))

        src = b'''__kernel void spike(__global float* o) {
            int id = get_global_id(0);
            float x = (float)id;
            for (int i=0; i<40000; i++) x = x * 1.0001f + 0.5f;
            o[id] = x;
        }'''
        src_p = ctypes.c_char_p(src)
        src_l = ctypes.c_size_t(len(src))
        prog = cl.clCreateProgramWithSource(ctx, 1, ctypes.byref(src_p), ctypes.byref(src_l), ctypes.byref(err))
        cl.clBuildProgram(prog, 1, ctypes.byref(device), None, None, None)
        kernel = cl.clCreateKernel(prog, b'spike', ctypes.byref(err))

        buf = ctypes.c_void_p(cl.clCreateBuffer(ctx, 1, 1024 * 1024 * 4, None, ctypes.byref(err)))
        cl.clSetKernelArg(kernel, 0, ctypes.sizeof(ctypes.c_void_p), ctypes.byref(buf))

        work = (ctypes.c_size_t * 1)(1024 * 256)
        hwmon_dir = find_legion_hwmon()
        temp_file = os.path.join(hwmon_dir, "temp2_input") if hwmon_dir else "/sys/devices/platform/legion/hwmon/hwmon5/temp2_input"

        print(f"[LOQer] Spiking GPU compute load (100%) for {seconds} seconds...")
        t0 = time.time()
        passes = 0
        last_print = 0
        while time.time() - t0 < seconds:
            cl.clEnqueueNDRangeKernel(queue, kernel, 1, None, work, None, 0, None, None)
            cl.clFinish(queue)
            passes += 1
            elapsed = time.time() - t0
            if int(elapsed) > last_print:
                last_print = int(elapsed)
                temp = "--"
                try:
                    if os.path.isfile(temp_file):
                        with open(temp_file) as f:
                            temp = f"{int(f.read().strip()) // 1000}°C"
                except Exception:
                    pass
                print(f"  [{last_print}s / {seconds}s] RTX 4060 Active (100% Load) · Temp: {temp} · Passes: {passes}")

        print(f"[LOQer] Completed {passes} parallel OpenCL compute batches. GPU operational and healthy!")
    except Exception as e:
        sys.stderr.write(f"[LOQer] GPU test error: {e}\n")

def print_status():
    refresh_env_paths()
    if os.environ.get("LOQ_STATUS_FILE"):
        status_path = os.environ["LOQ_STATUS_FILE"]
    else:
        status_path = STATUS_FILE
        if not os.path.isfile(status_path):
            for fallback in ("/run/user/1000/lenovo-power-status.json", "/run/lenovo-power-status.json"):
                if os.path.isfile(fallback):
                    status_path = fallback
                    break
    if not os.path.isfile(status_path):
        sys.stderr.write(f"Error: Status file '{status_path}' not found\n")
        return False
    try:
        with open(status_path, "r") as f:
            content = f.read()
        print(content.strip())
        return True
    except Exception as e:
        sys.stderr.write(f"Error reading status file '{status_path}': {e}\n")
        return False

def main():
    refresh_env_paths()
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print("Usage: loq-ctl [profile|mux|fancurve|bootlogo|conservation|fn_lock|fan_fullspeed|touchpad|winkey|overdrive|kbd|ioport|refresh|powerlimits|test-gpu|status] [value...]")
        return 0

    cmd = sys.argv[1].lower()
    args = sys.argv[2:]

    dispatch = {
        "profile": lambda: set_profile(args[0] if args else ""),
        "mux": lambda: set_mux(args[0] if args else ""),
        "igpumode": lambda: set_mux(args[0] if args else ""),
        "fancurve": lambda: handle_fancurve(args),
        "fan": lambda: handle_fancurve(args),
        "bootlogo": lambda: handle_bootlogo(args),
        "logo": lambda: handle_bootlogo(args),
        "conservation": lambda: set_ideapad_attribute("conservation_mode", args[0] if args else ""),
        "fn_lock": lambda: set_ideapad_attribute("fn_lock", args[0] if args else ""),
        "fnlock": lambda: set_ideapad_attribute("fn_lock", args[0] if args else ""),
        "fan_fullspeed": lambda: set_fan_fullspeed(args[0] if args else ""),
        "fullspeed": lambda: set_fan_fullspeed(args[0] if args else ""),
        "touchpad": lambda: toggle_bool(os.path.join(LEGION_DIR, "touchpad"), args[0] if args else ""),
        "winkey": lambda: toggle_bool(os.path.join(LEGION_DIR, "winkey"), args[0] if args else ""),
        "overdrive": lambda: toggle_bool(os.path.join(LEGION_DIR, "overdrive"), args[0] if args else ""),
        "kbd": lambda: set_kbd(args[0] if args else ""),
        "ioport": lambda: toggle_bool(os.path.join(LEGION_DIR, "leds/platform::ioport/brightness") if os.path.exists(os.path.join(LEGION_DIR, "leds/platform::ioport/brightness")) else "/sys/devices/platform/legion/leds/platform::ioport/brightness", args[0] if args else ""),
        "refresh": lambda: set_refresh(args[0] if args else ""),
        "powerlimits": lambda: set_powerlimits(args),
        "test-gpu": lambda: run_gpu_spike(int(args[0]) if args and args[0].isdigit() else 4),
        "gpu-spike": lambda: run_gpu_spike(int(args[0]) if args and args[0].isdigit() else 4),
        "gputest": lambda: run_gpu_spike(int(args[0]) if args and args[0].isdigit() else 4),
        "status": lambda: print_status()
    }

    if cmd in dispatch:
        res = dispatch[cmd]()
        if res is False:
            sys.exit(1)
    else:
        sys.stderr.write(f"Error: Unknown command '{cmd}'\n")
        sys.exit(1)

if __name__ == "__main__":
    main()
